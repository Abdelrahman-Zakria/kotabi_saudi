platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting build performance.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_install_all_ios_pods(installer)
  extension_targets = []
  helper_dir = File.join('..', '.symlinks', 'plugins', 'flutter_local_notifications', 'ios', 'Classes')
  if File.exist?(helper_dir)
    extension_targets << 'Runner'
  end
  flutter_install_ios_plugin_pods(installer)
end

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Fix for google_mobile_ads non-modular header issue
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

      # Ensure minimum deployment target is met
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Fix for architectures
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
    end
  end
end
